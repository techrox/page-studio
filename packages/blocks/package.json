{
  "name": "@techrox/page-studio-blocks",
  "version": "1.1.2",
  "description": "50 production-ready content blocks (Hero, Pricing, FAQ, Contact, …) plus the Puck config builder for @techrox/page-studio. SSR-safe, brand-themable via CSS variables, host-extensible.",
  "license": "MIT",
  "author": "techrox",
  "homepage": "https://github.com/techrox/page-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techrox/page-studio.git",
    "directory": "packages/blocks"
  },
  "bugs": {
    "url": "https://github.com/techrox/page-studio/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5",
    "@puckeditor/core": ">=0.21",
    "antd": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.4.0",
    "@puckeditor/core": "^0.21.2",
    "antd": "^5.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "blocks",
    "content-blocks",
    "page-builder",
    "puck",
    "puckeditor",
    "cms",
    "react",
    "ssr",
    "page-studio"
  ],
  "engines": {
    "node": ">=18"
  }
}
