{
  "name": "@techrox/page-studio-renderer",
  "version": "1.0.0",
  "description": "SSR-safe React renderer for displaying saved Puck JSON from @techrox/page-studio on a public page. Small footprint, no editor dependencies.",
  "license": "MIT",
  "author": "techrox",
  "homepage": "https://github.com/techrox/page-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techrox/page-studio.git",
    "directory": "packages/renderer"
  },
  "bugs": {
    "url": "https://github.com/techrox/page-studio/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@puckeditor/core": ">=0.21",
    "@techrox/page-studio-blocks": "workspace:*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@puckeditor/core": "^0.21.2",
    "@techrox/page-studio-blocks": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "renderer",
    "ssr",
    "page-renderer",
    "puck",
    "puckeditor",
    "cms",
    "react",
    "headless",
    "page-studio"
  ],
  "engines": {
    "node": ">=18"
  }
}
